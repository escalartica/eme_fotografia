# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...salvo la PLANTILLA, que no lleva ningún valor y es lo único que le dice a
# quien despliega qué variables hacen falta. Sin esta excepción, `.env*` se la
# lleva también y un clon nuevo se queda sin ninguna pista: el servidor no
# arranca (instrumentation.ts exige las del panel) y no hay dónde mirar por qué.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# contact submissions
data/contact-submissions/

# private client galleries, admin credentials, and session tokens
data/galleries/
data/admin/
data/sessions/

# QA artifacts
lighthouse-report.json

# third-party Claude Code agent-skill packages (installed via `skills` CLI)
# not part of this app -- keep out of app history and out of `git add -A`
/.agents/
/.claude/
/skills-lock.json

# local Playwright CLI session artifacts (screenshots, snapshots, console
# logs from manual browser-driven verification) -- not part of this app
/.playwright-cli/
data/analytics/

# Scratch output from assistant sessions (tool logs, backups). Never source.
_claude_tmp/
CLAUDE.backup.md

# Cache de Python de los scripts de etalonaje (scripts/grade-photos.py).
__pycache__/

# Material que las sesiones de trabajo han apartado para revisar o borrar, y
# entradas de medios sin procesar. 19 MB de código muerto, vídeos sin uso y
# hojas de cálculo que estaban dentro del repositorio y sin ignorar: tal cual
# entraban en el commit y se desplegaban. Los ficheros siguen en el disco
# para que el estudio los revise; lo que se corta es que viajen.
_to_delete/
_incoming-media/
_incoming_badges/
_entrada-*
_revision*.txt
