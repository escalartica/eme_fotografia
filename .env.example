# ---- Dominio público ------------------------------------------------------
# Origen canónico, SIN barra final. Alimenta los canonical, og:url,
# sitemap.xml, robots.txt y todo el JSON-LD. Si no se fija, se usa el dominio
# .com: si ese no es el que sirve el HTML, Google no indexa nada.
# El .es, cuando se compre, NO sirve una copia: redirige aquí con un 308
# (ver la sección redirects() de next.config.mjs).
NEXT_PUBLIC_SITE_URL=https://www.emefotografiasevilla.com

# ---- Panel de administración (OBLIGATORIO) -----------------------------------
# Sin estas variables el servidor NO arranca (instrumentation.ts lo comprueba al
# levantarse). Antes había una contraseña escrita en el código que se sembraba
# sola: cualquiera que leyera el repositorio podía entrar en /admin.
ADMIN_USERNAME=admin
# Forma preferida: el hash, no la contraseña. Genéralo con
#   node scripts/hash-admin-password.mjs 'la contraseña que elijas'
# y pega aquí la línea entera que imprime. Así la contraseña en claro no existe
# en ningún sitio del hosting.
ADMIN_PASSWORD_HASH=
# Alternativa (usa UNA de las dos, no las dos): la contraseña en claro, mínimo
# 12 caracteres. Se convierte a hash en memoria al arrancar y nunca se escribe
# en disco, pero queda visible en el panel de variables del hosting.
# ADMIN_PASSWORD=

# ---- Formulario de contacto (lib/mail.ts) ------------------------------------
# Clave de API de Resend (https://resend.com). Sin ella, los mensajes se guardan
# en data/contact-submissions/ y se listan en /admin/mensajes, pero NO se envían
# por correo.
RESEND_API_KEY=
# Buzón que recibe las solicitudes (varios separados por coma).
# Los dos buzones del estudio, separados por coma. Deben EXISTIR: un
# destinatario inexistente rebota y puede tumbar el envío entero.
CONTACT_TO=contratos@emefotografiasevilla.com,info@emefotografiasevilla.com
# Remitente. El dominio debe estar verificado en Resend (registros DNS).
CONTACT_FROM="EME Fotografía Sevilla <web@emefotografiasevilla.com>"

# ---- Google Analytics 4 (opcional) -------------------------------------------
# Solo se carga si el visitante pulsa "Aceptar" en el banner de cookies. La
# analítica propia sin cookies (/admin/estadisticas) funciona siempre y no
# necesita nada de esto.
NEXT_PUBLIC_GA_ID=
